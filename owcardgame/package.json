{
  "name": "owcardgame",
  "description": "Overwatch-themed tactical card battler",
  "author": "CamSmith",
  "homepage": "https://camerensmith.github.io/owtacticards",
  "version": "0.3.2",
  "private": true,
  "main": "electron/main.js",
  "dependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "immer": "^10.0.5",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "pixi.js": "^8.20.1",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^3.5.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "build:electron": "cross-env PUBLIC_URL=./ DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "cp build/index.html build/404.html || copy build\\index.html build\\404.html",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron:start": "npm run build:electron && electron .",
    "electron:dist": "npm run build:electron && electron-builder --win"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.camerensmith.owtacticards",
    "productName": "Overwatch Card Game",
    "copyright": "Copyright © CamSmith",
    "directories": {
      "output": "dist",
      "buildResources": "electron/builder-resources"
    },
    "extends": null,
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!electron/builder-resources/**/*",
      "!**/node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
